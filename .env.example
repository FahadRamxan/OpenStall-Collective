# Copy to .env and fill in. Never commit .env: the repo is public.
# An empty value means "not set", so the default applies. Environment variables override this file.

# fake: deterministic stand-ins for PayPal, Twilio and the AI models. Needs no keys. Tests always use it.
# sandbox: the real PayPal sandbox, Twilio WhatsApp sandbox and AI models. Needs the keys below.
OPENSTALL_MODE=fake

# Where the API is reachable from outside (the hosted demo URL in production)
PUBLIC_BASE_URL=http://localhost:8000

# Where the web app runs. The API accepts browser requests (CORS) only from this origin.
WEB_BASE_URL=http://localhost:3000

# PayPal sandbox REST app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# How sellers are paid: payouts (the platform holds the authorization and pays each seller with Payouts when she ships)
# or multiparty (each seller is a payee on the PayPal order). The day-one payment check decides; empty means payouts.
PAYMENT_PATH=

# Twilio WhatsApp sandbox: console.twilio.com > Messaging > Try it out
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# AI models. Keep the providers you choose and record them in docs/day-one-checks.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The Claude model for text and photos
LLM_MODEL=claude-sonnet-5-5

# Reverse image search for the photo originality check (Google Cloud Vision web detection)
GOOGLE_VISION_API_KEY=

# Database. Empty means a SQLite file at data/openstall.db. For the Postgres in docker-compose.yml use
# postgresql://openstall:openstall@localhost:5432/openstall
DATABASE_URL=
# Apply database migrations when the API starts (default true). The hosted demo runs them in its start command.
AUTO_MIGRATE=

# Trust passports: Ed25519 private key, base64
PASSPORT_SIGNING_KEY=
