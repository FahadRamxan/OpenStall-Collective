# Copy to .env and fill in. Never commit .env: the repo is public.

# Where the API is reachable from outside (the hosted demo URL in production)
PUBLIC_BASE_URL=http://localhost:8000

# PayPal sandbox REST app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Twilio WhatsApp sandbox: console.twilio.com > Messaging > Try it out
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# AI models. Keep the providers you choose and record them in docs/day-one-checks.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://openstall:openstall@localhost:5432/openstall

# Trust passports: Ed25519 private key, base64
PASSPORT_SIGNING_KEY=
